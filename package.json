{
  "name": "@arloraccoon/openclaw-vaultwarden-plugin",
  "version": "0.1.2",
  "description": "Metadata-safe Vaultwarden tools for OpenClaw with opt-in item mutations",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --external:openclaw '--external:openclaw/*' --external:typebox --outfile=dist/index.mjs && esbuild src/secret-resolver-entry.ts --bundle --platform=node --format=esm --outfile=dist/secret-resolver.mjs",
    "test": "vitest run src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArloTheRaccoon/openclaw-vaultwarden-plugin"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "0.28.0",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ],
    "install": {
      "npmSpec": "@arloraccoon/openclaw-vaultwarden-plugin",
      "clawhubSpec": "clawhub:openclaw-vaultwarden-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.8"
    },
    "compat": {
      "pluginApi": ">=2026.5.19"
    },
    "release": {
      "publishToNpm": true,
      "publishToClawHub": true
    },
    "build": {
      "openclawVersion": "2026.9.8"
    }
  }
}
