{
  "id": "vaultwarden",
  "name": "Vaultwarden",
  "description": "Bitwarden-compatible Vaultwarden tools for OpenClaw",
  "activation": {
    "onStartup": false
  },
  "contracts": {
    "tools": [
      "vaultwarden_status",
      "vaultwarden_search",
      "vaultwarden_get_item",
      "vaultwarden_list_folders",
      "vaultwarden_list_collections"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "adapter": {
        "type": "string",
        "enum": ["cli"]
      },
      "sessionEnv": {
        "type": "string",
        "minLength": 1
      },
      "session": {
        "description": "Bitwarden CLI session token; prefer an OpenClaw SecretRef.",
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "provider", "id"],
            "properties": {
              "source": {
                "type": "string",
                "enum": ["env", "file", "exec"]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "timeoutSeconds": {
        "type": "number",
        "minimum": 1,
        "maximum": 120
      },
      "maxResults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  }
}
